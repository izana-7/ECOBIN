# EcoBin Frontend Environment Variables

# Backend API base URL (required for deployed frontend; local dev can keep /api with Vite proxy)
VITE_API_URL=/api

# Optional Map API Keys (Google Maps/OSM/Esri layers work without keys; add keys if you have them)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_MAP_API_KEY=your_map_provider_api_key
VITE_MAPBOX_TOKEN=your_mapbox_token
