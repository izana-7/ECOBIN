# EcoBin Application Environment Variables

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ecobin
JWT_SECRET=ecobin_super_secret_jwt_key_2026

# Cloudinary Setup (Optional - Falls back to local base64/DataURI storage if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Vision AI Setup (Optional - Uses built-in heuristic computer vision model if omitted)
GOOGLE_VISION_API_KEY=your_google_vision_api_key
